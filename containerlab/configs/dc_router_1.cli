enter candidate
set / system name host-name R3

set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 3.3.3.3/32

set / interface ethernet-1/1 description "Link to R1"
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 192.168.0.10/30

set / interface ethernet-1/2 description "Link to R2"
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 192.168.0.13/30

set / routing-policy policy ACCEPT-ALL default-action policy-result accept

set / network-instance default interface system0.0
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0

set / network-instance default protocols ospf instance 1 admin-state enable
set / network-instance default protocols ospf instance 1 version ospf-v2
set / network-instance default protocols ospf instance 1 router-id 3.3.3.3
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface system0.0 admin-state enable
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface ethernet-1/1.0 admin-state enable
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface ethernet-1/1.0 interface-type point-to-point
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface ethernet-1/2.0 admin-state enable
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface ethernet-1/2.0 interface-type point-to-point

set / network-instance default protocols bgp autonomous-system 65000
set / network-instance default protocols bgp router-id 3.3.3.3
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable

set / network-instance default protocols bgp group IBGP-LOOPBACK peer-as 65000
set / network-instance default protocols bgp group IBGP-LOOPBACK transport local-address 3.3.3.3
set / network-instance default protocols bgp group IBGP-LOOPBACK export-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp group IBGP-LOOPBACK import-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp neighbor 1.1.1.1 peer-group IBGP-LOOPBACK
set / network-instance default protocols bgp neighbor 2.2.2.2 peer-group IBGP-LOOPBACK
set / network-instance default protocols bgp neighbor 4.4.4.4 peer-group IBGP-LOOPBACK

commit save
