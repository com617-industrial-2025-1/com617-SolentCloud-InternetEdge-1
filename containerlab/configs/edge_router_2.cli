enter candidate
set / system name host-name R6

set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 6.6.6.6/32

set / interface ethernet-1/1 description "Link to Core 1"
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 192.168.1.6/30

set / interface ethernet-1/2 description "Link to Core 2"
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 192.168.1.14/30

set / routing-policy policy ACCEPT-ALL default-action policy-result accept

set / network-instance default interface system0.0
set / network-instance default interface ethernet-1/1.0
set / network-instance default interface ethernet-1/2.0

set / network-instance default protocols bgp autonomous-system 65000
set / network-instance default protocols bgp router-id 6.6.6.6
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable

set / network-instance default protocols bgp group IBGP-PHYSICAL peer-as 65000
set / network-instance default protocols bgp group IBGP-PHYSICAL export-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp group IBGP-PHYSICAL import-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp neighbor 192.168.1.5 peer-group IBGP-PHYSICAL
set / network-instance default protocols bgp neighbor 192.168.1.13 peer-group IBGP-PHYSICAL

commit save
