enter candidate
set / system name host-name R1

set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 1.1.1.1/32

set / interface ethernet-1/2 description "Link to DC1 (R3)"
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 192.168.0.9/30

set / interface ethernet-1/3 description "Link to DC2 (R4)"
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/3 subinterface 0 ipv4 address 192.168.0.17/30

set / interface ethernet-1/4 description "Link to R5 (Red Zone)"
set / interface ethernet-1/4 admin-state enable
set / interface ethernet-1/4 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/4 subinterface 0 ipv4 address 192.168.1.1/30

set / interface ethernet-1/5 description "Link to R6 (Red Zone)"
set / interface ethernet-1/5 admin-state enable
set / interface ethernet-1/5 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/5 subinterface 0 ipv4 address 192.168.1.5/30

set / routing-policy policy ACCEPT-ALL default-action policy-result accept

set / network-instance default interface system0.0
set / network-instance default interface ethernet-1/2.0
set / network-instance default interface ethernet-1/3.0
set / network-instance default interface ethernet-1/4.0
set / network-instance default interface ethernet-1/5.0

set / network-instance default protocols ospf instance 1 admin-state enable
set / network-instance default protocols ospf instance 1 version ospf-v2
set / network-instance default protocols ospf instance 1 router-id 1.1.1.1
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface system0.0 admin-state enable
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface ethernet-1/2.0 admin-state enable
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface ethernet-1/2.0 interface-type point-to-point
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface ethernet-1/3.0 admin-state enable
set / network-instance default protocols ospf instance 1 area 0.0.0.0 interface ethernet-1/3.0 interface-type point-to-point

set / network-instance default protocols bgp autonomous-system 65000
set / network-instance default protocols bgp router-id 1.1.1.1
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable

set / network-instance default protocols bgp group IBGP-LOOPBACK peer-as 65000
set / network-instance default protocols bgp group IBGP-LOOPBACK transport local-address 1.1.1.1
set / network-instance default protocols bgp group IBGP-LOOPBACK export-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp group IBGP-LOOPBACK import-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp neighbor 2.2.2.2 peer-group IBGP-LOOPBACK
set / network-instance default protocols bgp neighbor 3.3.3.3 peer-group IBGP-LOOPBACK
set / network-instance default protocols bgp neighbor 4.4.4.4 peer-group IBGP-LOOPBACK

set / network-instance default protocols bgp group IBGP-PHYSICAL peer-as 65000
set / network-instance default protocols bgp group IBGP-PHYSICAL export-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp group IBGP-PHYSICAL import-policy [ ACCEPT-ALL ]
set / network-instance default protocols bgp neighbor 192.168.1.2 peer-group IBGP-PHYSICAL
set / network-instance default protocols bgp neighbor 192.168.1.6 peer-group IBGP-PHYSICAL

